NODE_ENV=development
API_PORT=3000
METRICS_PORT=9100

DATABASE_URL=postgres://app:app@postgres:5432/locations
DATABASE_READ_URL=
REDIS_URL=redis://redis:6379

STREAM_PARTITIONS=16
STREAM_MAXLEN=2000000
BACKPRESSURE_MAX_PENDING=500000
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=1000
PARTITION_LEASE_TTL_MS=15000
PARTITION_LEASE_RENEW_MS=5000
MAX_DELIVERY_ATTEMPTS=5

GEOFENCE_INDEX=rtree
H3_INDEX_RESOLUTION=9
H3_SKIP_RESOLUTION=11
AREA_INDEX_REFRESH_MS=30000

EXIT_CONFIRM_POINTS=3
EXIT_CONFIRM_MS=30000
FORCE_EVAL_MS=60000
STATE_REFRESH_MS=300000
SIGNAL_TIMEOUT_MS=600000
SWEEPER_INTERVAL_MS=60000

USER_FILTER_TTL_S=3600
TS_MAX_FUTURE_MS=60000
TS_MAX_PAST_MS=86400000
MAX_BATCH_LOCATIONS=100
MAX_POLYGON_VERTICES=10000
RATE_LIMIT_PER_MIN=120
