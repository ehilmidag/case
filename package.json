{
  "name": "location-tracking-service",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "migration:run": "npm run build && node dist/database/migration-runner.js",
    "migration:revert": "npm run build && node dist/database/migration-runner.js revert",
    "partitions:ensure": "npm run build && node dist/database/partition-maintenance.js",
    "start": "node dist/main.api.js",
    "start:dev": "nest start --watch --entryFile main.api",
    "start:debug": "nest start --debug --watch --entryFile main.api",
    "start:prod": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "start:worker:dev": "nest start --watch --entryFile main.worker",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=\\.e2e-spec\\.ts$",
    "test:e2e": "jest --runInBand --testPathPattern=\\.e2e-spec\\.ts$",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "@turf/boolean-disjoint": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/boolean-within": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "flatbush": "^3.3.1",
    "h3-js": "^4.5.0",
    "@nestjs/throttler": "^6.7.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "lru-cache": "^11.5.3",
    "murmurhash-js": "^1.0.0",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.1",
    "@types/flatbush": "^3.3.0",
    "@types/jest": "^29.5.14",
    "@types/murmurhash-js": "^1.0.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "fast-check": "^4.10.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
